# Copy as .env. Demo runs with zero credentials.
SHOP_NAME=PulseTopup
PUBLIC_URL=http://127.0.0.1:8000
DATABASE_PATH=./store.db
ADMIN_KEY=PASTE_A_RANDOM_SECRET_AT_LEAST_24_CHARACTERS

# demo | selcom_test | selcom_live
PAYMENT_MODE=demo
# demo | manual | gamecore_test | gamecore_live
FULFILLMENT_MODE=demo

# SELCOM: https://selcom.com.na/developers/quickstart
SELCOM_PK=
SELCOM_SK=
SELCOM_WEBHOOK_SECRET=

# GameCore: https://gamecore-api.tech/en/docs
GAMECORE_KEY=
GAMECORE_WEBHOOK_SECRET=
# Only set true for verified GameCore self-service simulation accounts.
GAMECORE_TEST_RAIL_CONFIRMED=false

# Live mode is refused on ephemeral storage (such as a Render Free web service).
# Upgrade to a paid Render service with mounted persistent disk at /var/data,
# or migrate to a durable hosted relational database before accepting payments.
# This variable is a merchant attestation, not an automatic disk check.
DURABLE_STORAGE_CONFIRMED=false

# For live mode only. Set true ONLY after approval and setting verified real prices.
SUPPLY_AUTHORIZATION_CONFIRMED=false
CATALOG_PRICES_APPROVED=false